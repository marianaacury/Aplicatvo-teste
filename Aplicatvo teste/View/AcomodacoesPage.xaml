<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplicatvo_teste.View.AcomodacoesPage"
             Title="AcomodacoesPage"
             BackgroundColor="{StaticResource Creme}">

    <Shell.TitleView>

        <Label 
        Text="Acomodações"
        FontSize="18"
        FontAttributes="Bold"
        TextColor="{StaticResource BrancoQuente}"
        VerticalOptions="Center"/>
    </Shell.TitleView>
    <ScrollView>
        <VerticalStackLayout Spacing="0">



            <VerticalStackLayout 
        BackgroundColor="{StaticResource VerdeEscuro}"
        Padding="24,20,24,24">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="IrMainPage"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label
                Text="&lt;"
                FontSize="24"
                TextColor="{StaticResource Terracota}"
                VerticalOptions="Center"/>

                <Label
                Text="Nossas Acomodações"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="{StaticResource BrancoQuente}"/>
                <Label
                Text="16 suítes exclusivas com piscina privativa e banheira de hidromassagem"
                FontSize="13"
                TextColor="{StaticResource CremeEscuro}"
                Margin="0,6,0,0"/>
            </VerticalStackLayout>


            <VerticalStackLayout Padding="20" Spacing="16">

                <CollectionView x:Name="ListaQuartos">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">

                                <Image 
                                Source="{Binding Imagem}"
                                Aspect="AspectFill"
                                HeightRequest="200"/>

                                <Border 
                                StrokeShape="RoundRectangle 14"
                                Stroke="{StaticResource CremeEscuro}"
                                StrokeThickness="1"
                                Margin="0,0,0,4">

                                    <VerticalStackLayout BackgroundColor="{StaticResource BrancoQuente}" Spacing="0">

                                        <Grid 
                                        BackgroundColor="{StaticResource VerdeMedio}"
                                        Padding="18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>



                                            <Label 
                                            Grid.Column="0"
                                            Text="{Binding Nome}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrancoQuente}"
                                            VerticalOptions="Center"/>

                                            <Border 
                                            Grid.Column="1"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource Terracota}"
                                            Padding="10,4">
                                                <Label 
                                                Text="{Binding Preco, StringFormat='R$ {0:F0}'}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="White"/>
                                            </Border>
                                        </Grid>

                                        <VerticalStackLayout Padding="18,14" Spacing="10">

                                            <Label 
                                            Text="{Binding Descricao}"
                                            FontSize="14"
                                            TextColor="{StaticResource TextoSecundario}"/>

                                            <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{StaticResource Gray100}" Padding="8,4">
                                                    <Label Text="🏊 Piscina privativa" FontSize="11" TextColor="{StaticResource TextoSecundario}"/>
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{StaticResource Gray100}" Padding="8,4">
                                                    <Label Text="🛁 Hidromassagem" FontSize="11" TextColor="{StaticResource TextoSecundario}"/>
                                                </Border>
                                            </HorizontalStackLayout>

                                            <Label 
                                            Text="por noite"
                                            FontSize="11"
                                            TextColor="{StaticResource TextoSecundario}"/>

                                        </VerticalStackLayout>
                                    </VerticalStackLayout>

                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>